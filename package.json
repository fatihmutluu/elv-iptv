{
  "name": "elv-iptv",
  "private": true,
  "version": "0.0.0",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.18.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "check": "node tools/bin/check.ts",
    "bootstrap": "node tools/bin/bootstrap.ts",
    "dev:ui": "pnpm --filter @elv/desktop run dev:ui",
    "dev:desktop": "pnpm --filter @elv/desktop run dev:hot",
    "run:app": "node tools/bin/run-app.ts",
    "scaffold": "node tools/bin/scaffold.ts",
    "sim": "node tools/bin/sim.ts",
    "gate": "node tools/bin/gate.ts",
    "mpv": "node tools/bin/mpv.ts",
    "ffmpeg-media3": "node tools/bin/ffmpeg-media3.ts",
    "notices:sync": "node tools/bin/notices.ts --write",
    "telemetry:digest": "node tools/bin/telemetry-digest.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "dependency-cruiser": "18.7.2",
    "knip": "6.45.1",
    "lefthook": "2.2.2",
    "typescript": "~6.0.3"
  }
}
