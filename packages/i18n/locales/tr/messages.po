msgid "source.validation.missingServer"
msgstr "Xtream sunucu adresini girin."

msgid "source.hint.missingServer"
msgstr "Sağlayıcınız belirttiyse http:// veya https:// ile bağlantı noktasını ekleyin."

msgid "source.validation.missingCredentials"
msgstr "Kullanıcı adı ve parolanın ikisini de girin."

msgid "source.hint.missingCredentials"
msgstr "Sağlayıcınızın verdiği Xtream hesap bilgilerini kontrol edin veya tam get.php bağlantısını yapıştırın."

msgid "source.validation.missingUrl"
msgstr "M3U çalma listesi adresini girin."

msgid "source.hint.missingUrl"
msgstr "Tam bir http:// veya https:// çalma listesi bağlantısı yapıştırın."

msgid "source.validation.missingScheme"
msgstr "Sunucu veya çalma listesi adresi http:// ya da https:// ile başlamalıdır."

msgid "source.hint.missingScheme"
msgstr "Adresin başına http:// (veya https://) ekleyip tekrar deneyin."

msgid "source.validation.unsupportedScheme"
msgstr "Yalnızca http:// ve https:// adresleri desteklenir."

msgid "source.hint.unsupportedScheme"
msgstr "Adres şemasını http:// veya https:// ile değiştirin."

msgid "source.validation.invalidAddress"
msgstr "Sunucu veya bağlantı adresi geçerli değil."

msgid "source.hint.invalidAddress"
msgstr "Sunucu adını kontrol edin ve bağlantı noktası numarasının 1 ile 65535 arasında olduğundan emin olun."

msgid "source.validation.invalidGuideUrl"
msgstr "XMLTV rehber adresi geçerli değil."

msgid "source.hint.invalidGuideUrl"
msgstr "Varsayılan rehberi kullanmak için boş bırakın veya tam bir http:// ya da https:// adresi girin."

msgid "source.validation.invalidCharacters"
msgstr "Alanlardan biri desteklenmeyen kontrol karakterleri içeriyor."

msgid "source.hint.invalidCharacters"
msgstr "Yapıştırılan metindeki satır sonlarını veya gizli karakterleri kaldırıp tekrar deneyin."

msgid "source.validation.m3uInXtream"
msgstr "Bu adres bir Xtream sunucusu değil, M3U çalma listesi dosyası gibi görünüyor."

msgid "source.hint.m3uInXtream"
msgstr ".m3u veya .m3u8 listesi eklemek için M3U Adresi kipine geçin ya da yalnızca Xtream sunucu kök adresini girin."

msgid "source.error.invalidCredentials"
msgstr "Giriş başarısız: kullanıcı adı, parola veya erişim anahtarı geçersiz."

msgid "source.hint.invalidCredentials"
msgstr "Bilgilerinizi sağlayıcınızla doğrulayın, ardından kaynağı kaldırıp yeniden ekleyin."

msgid "source.error.accountExpired"
msgstr "Bu sağlayıcı hesabının süresi dolmuş veya hesap etkin değil."

msgid "source.hint.accountExpired"
msgstr "Sağlayıcınızdan abonelik durumunuzu kontrol edin ve etkinleştiğinde yenileyin."

msgid "source.error.rateLimited"
msgstr "Sağlayıcı, bağlantı veya istek sınırı nedeniyle isteği reddetti."

msgid "source.hint.rateLimited"
msgstr "Diğer cihazlardaki yayınları kapatın, biraz bekleyin ve Yenile düğmesine basın."

msgid "source.error.timeout"
msgstr "Sunucu yanıt vermekte gecikti."

msgid "source.hint.timeout"
msgstr "Ağ bağlantınızı ve sunucu adresini kontrol edin, ardından Yenile düğmesine basın."

msgid "source.error.notFound"
msgstr "Çalma listesi veya panel uç noktası sunucuda bulunamadı (HTTP 404)."

msgid "source.hint.notFound"
msgstr "Adres yolunu ve bağlantı noktasını kontrol edin, ardından kaynağı kaldırıp yeniden ekleyin."

msgid "source.error.unreachable"
msgstr "Sunucuya ulaşılamadı."

msgid "source.hint.unreachable"
msgstr "Sunucu adresini, bağlantı noktasını ve ağ bağlantınızı kontrol edip Yenile düğmesine basın."

msgid "source.error.aborted"
msgstr "İçe aktarma iptal edildi."

msgid "source.hint.aborted"
msgstr "Tekrar denemek istediğinizde İçe aktar veya Yenile düğmesine basın."

msgid "source.error.emptyPlaylist"
msgstr "Kaynak yanıt verdi ancak içinde hiç kanal, film veya dizi bulunamadı."

msgid "source.hint.emptyPlaylist"
msgstr "Çalma listesine veya hesaba etkin kanallar tanımlandığını sağlayıcınızla doğrulayın."

msgid "source.error.tooLarge"
msgstr "Çalma listesi veya sunucu yanıtı cihaz boyut sınırını aştı."

msgid "source.hint.tooLarge"
msgstr "Bu bir Xtream sağlayıcısıysa ham M3U dosyası yerine Xtream kipinde ekleyin."

msgid "source.error.invalidFormat"
msgstr "Sunucu yanıtı geçerli bir M3U çalma listesi veya Xtream kataloğu değil."

msgid "source.hint.invalidFormat"
msgstr "Adresin bir web sayfasına değil, doğrudan M3U listesine veya Xtream sunucusuna işaret ettiğini kontrol edin."

msgid "source.error.importInProgress"
msgstr "Bu kaynak için zaten devam eden bir içe aktarma var."

msgid "source.hint.importInProgress"
msgstr "Mevcut içe aktarmanın bitmesini bekleyin veya önce iptal edin."

msgid "source.error.secretStore"
msgstr "Bu cihazda güvenli kimlik bilgisi deposu kullanılamıyor."

msgid "source.hint.secretStore"
msgstr "İşletim sistemi anahtarlığının veya ekran kilidi şifrelemesinin etkin olduğundan emin olup uygulamayı yeniden başlatın."

msgid "source.error.storage"
msgstr "Katalog verileri yerel depolamaya kaydedilemedi."

msgid "source.hint.storage"
msgstr "Boş disk alanını kontrol edip kaynağı yenilemeyi deneyin."
