msgid "source.validation.missingServer"
msgstr "Enter the Xtream server URL."

msgid "source.hint.missingServer"
msgstr "Include http:// or https:// and the port if your provider gave one."

msgid "source.validation.missingCredentials"
msgstr "Enter both username and password."

msgid "source.hint.missingCredentials"
msgstr "Check the Xtream account details from your provider, or paste a full get.php link."

msgid "source.validation.missingUrl"
msgstr "Enter the M3U playlist URL."

msgid "source.hint.missingUrl"
msgstr "Paste a full http:// or https:// playlist link."

msgid "source.validation.missingScheme"
msgstr "Server or playlist URL must start with http:// or https://."

msgid "source.hint.missingScheme"
msgstr "Add http:// (or https://) in front of the address and try again."

msgid "source.validation.unsupportedScheme"
msgstr "Only http:// and https:// URLs are supported."

msgid "source.hint.unsupportedScheme"
msgstr "Replace the URL scheme with http:// or https://."

msgid "source.validation.invalidAddress"
msgstr "The server or URL address is not valid."

msgid "source.hint.invalidAddress"
msgstr "Check the hostname and ensure any port number is between 1 and 65535."

msgid "source.validation.invalidGuideUrl"
msgstr "The XMLTV guide URL is not valid."

msgid "source.hint.invalidGuideUrl"
msgstr "Leave the guide URL blank to use the default guide, or enter a full http:// or https:// URL."

msgid "source.validation.invalidCharacters"
msgstr "One of the fields contains unsupported control characters."

msgid "source.hint.invalidCharacters"
msgstr "Remove line breaks or hidden characters from the pasted text and try again."

msgid "source.validation.m3uInXtream"
msgstr "That looks like an M3U playlist file URL, not an Xtream server."

msgid "source.hint.m3uInXtream"
msgstr "Switch to M3U URL mode to add a .m3u or .m3u8 playlist, or enter only the Xtream server base address."

msgid "source.error.invalidCredentials"
msgstr "Sign-in failed: invalid username, password, or access token."

msgid "source.hint.invalidCredentials"
msgstr "Verify your credentials with your provider, then remove and re-add the source."

msgid "source.error.accountExpired"
msgstr "This provider account is expired or inactive."

msgid "source.hint.accountExpired"
msgstr "Check your subscription status with your provider and refresh once active."

msgid "source.error.rateLimited"
msgstr "The provider rejected the request due to a connection or rate limit."

msgid "source.hint.rateLimited"
msgstr "Close streams on other devices, wait a moment, and press Refresh."

msgid "source.error.timeout"
msgstr "The server took too long to respond."

msgid "source.hint.timeout"
msgstr "Check your network connection and server address, then press Refresh."

msgid "source.error.notFound"
msgstr "The playlist or panel endpoint was not found on the server (HTTP 404)."

msgid "source.hint.notFound"
msgstr "Check the URL path and port, then remove and re-add the source."

msgid "source.error.unreachable"
msgstr "Could not reach the server."

msgid "source.hint.unreachable"
msgstr "Check the server URL, port, and your network connection, then press Refresh."

msgid "source.error.aborted"
msgstr "Import was cancelled."

msgid "source.hint.aborted"
msgstr "Press Import or Refresh whenever you want to try again."

msgid "source.error.emptyPlaylist"
msgstr "The source responded, but contained zero channels, movies, or series."

msgid "source.hint.emptyPlaylist"
msgstr "Verify with your provider that the playlist or account has active channels assigned."

msgid "source.error.tooLarge"
msgstr "The playlist or response exceeded the device size limit."

msgid "source.hint.tooLarge"
msgstr "If this is an Xtream provider, add it in Xtream mode instead of a raw M3U file."

msgid "source.error.invalidFormat"
msgstr "The server response is not a valid M3U playlist or Xtream catalog."

msgid "source.hint.invalidFormat"
msgstr "Check that the URL points directly to an M3U playlist or Xtream server, not a web page."

msgid "source.error.importInProgress"
msgstr "An import is already running for this source."

msgid "source.hint.importInProgress"
msgstr "Wait for the current import to finish or cancel it first."

msgid "source.error.secretStore"
msgstr "Secure credential storage is unavailable on this device."

msgid "source.hint.secretStore"
msgstr "Ensure OS keychain or screen lock encryption is enabled and restart the app."

msgid "source.error.storage"
msgstr "Could not save catalog data to local storage."

msgid "source.hint.storage"
msgstr "Check available disk space and try refreshing the source."

