{
  "name": "@elv/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "ELV IPTV desktop app",
  "author": "ELV IPTV contributors",
  "main": "dist/main/main.js",
  "scripts": {
    "bundle": "esbuild src/main/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/main/main.js --log-level=warning && esbuild src/preload/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/preload.js --log-level=warning",
    "prepare:app": "pnpm --filter @elv/desktop-renderer --silent run export && pnpm run bundle",
    "dev": "pnpm run prepare:app && electron .",
    "build": "pnpm run prepare:app && electron-builder --publish never",
    "test": "vitest run --reporter=dot",
    "test:e2e": "pnpm run prepare:app && playwright test --reporter=line",
    "typecheck": "tsc --noEmit -p . --pretty false"
  },
  "devDependencies": {
    "@elv/config": "workspace:*",
    "@elv/desktop-renderer": "workspace:*",
    "@playwright/test": "1.65.0",
    "@types/node": "^24.19.2",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2",
    "vitest": "5.1.0"
  }
}
