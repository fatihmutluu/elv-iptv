{
  "name": "@elv/desktop",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-3.0-only",
  "description": "ELV IPTV desktop app",
  "author": "ELV IPTV contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/fatihmutluu/elv-iptv.git",
    "directory": "apps/desktop"
  },
  "main": "dist/main/main.js",
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "bundle:e2e": "esbuild e2e/presenter-probe.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/e2e/presenter-probe.js --log-level=warning",
    "prepare:app": "pnpm -w mpv fetch && pnpm --filter @elv/desktop-renderer --silent run export && pnpm run bundle",
    "dev": "pnpm run prepare:app && electron .",
    "dev:hot": "node scripts/dev-hot.mjs",
    "dev:ui": "node scripts/dev-ui.mjs",
    "build": "pnpm run prepare:app && electron-builder --publish never",
    "test": "vitest run --coverage --reporter=dot",
    "test:e2e": "pnpm run prepare:app && pnpm run bundle:e2e && playwright test --reporter=line",
    "typecheck": "tsc --noEmit -p . --pretty false"
  },
  "dependencies": {
    "@elv/data": "workspace:*",
    "@elv/domain": "workspace:*",
    "@elv/playback": "workspace:*",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@elv/config": "workspace:*",
    "@elv/desktop-renderer": "workspace:*",
    "@playwright/test": "1.65.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "catalog:",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2",
    "vitest": "5.1.0"
  }
}
