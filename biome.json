{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "extends": ["./packages/config/biome.json"],
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.expo",
      "!**/dist",
      "!**/build",
      "!**/coverage",
      "!**/android",
      "!**/ios",
      "!tools/test/fixtures",
      "!docs",
      "!.claude",
      "!**/*.md"
    ]
  },
  "overrides": [
    {
      "includes": ["tools/bin/**", "tools/src/cli-*.ts", "scripts/**"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    }
  ]
}
